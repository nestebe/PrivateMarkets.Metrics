<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PrivateMarkets.Metrics.Mcp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>PrivateMarkets.Metrics.Mcp</PackageId>
    <Description>MCP server exposing PrivateMarkets.Metrics (fund metrics, PME, vintage summaries, J-curves) to AI agents over stdio.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>privatemarkets-mcp</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrivateMarkets.Metrics\PrivateMarkets.Metrics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrivateMarkets.Metrics.Mcp.Tests" />
  </ItemGroup>

  <!-- Ships .mcp/server.json (MCP registry metadata read by nuget.org) stamped with the package version. -->
  <Target Name="StampMcpServerJson" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <StampedMcpServerJson>$(IntermediateOutputPath)server.json</StampedMcpServerJson>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(StampedMcpServerJson)"
      Lines="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.mcp/server.json').Replace('0.0.0-dev', '$(Version)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(StampedMcpServerJson)" Pack="true" PackagePath=".mcp/server.json" />
    </ItemGroup>
  </Target>

</Project>
